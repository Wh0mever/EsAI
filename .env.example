# ===========================================================================
# EsAI — пример переменных окружения. Скопируйте в .env и заполните значения.
#   cp .env.example .env
# НЕ коммитьте реальный .env (он в .gitignore). Все секреты — только здесь.
# ===========================================================================

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Хосты через запятую (без https://)
DJANGO_ALLOWED_HOSTS=esai.kg,www.esai.kg,127.0.0.1,localhost
# Доверенные origin для CSRF/CORS (со схемой https://)
CSRF_TRUSTED_ORIGINS=https://esai.kg,https://www.esai.kg
CORS_ALLOWED_ORIGINS=https://esai.kg,https://www.esai.kg
# Публичный базовый URL фронта (для редиректов соц-входа/платёжки)
SITE_BASE_URL=https://esai.kg

# --- SMTP (письма) ---
DEFAULT_FROM_EMAIL=EsAI <noreply@esai.kg>
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password

# --- PostgreSQL ---
POSTGRES_DB=esai
POSTGRES_USER=esai
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Frontend ---
# Фронт ходит в API по относительному /api/ (nginx проксирует на core).
NEXT_PUBLIC_API_URL=https://esai.kg

# --- OpenRouter (LLM-агрегатор) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# (опц.) заголовки атрибуции OpenRouter
# OPENROUTER_HTTP_REFERER=https://esai.kg
# OPENROUTER_X_TITLE=EsAI

# --- FreedomPay (оплата, KGS) ---
FREEDOM_PAY_MERCHANT_ID=000000
FREEDOM_PAY_TOKEN=secret-key-for-accepting-payments
FREEDOM_PAY_PUBLIC_KEY=
FREEDOM_PAY_API_BASE=https://api.freedompay.kg/v1
FREEDOM_PAY_DEFAULT_CURRENCY=KGS

# --- Криптооплата (NOWPayments) ---
# Процессор выдаёт адрес и точную сумму, следит за сетью и присылает
# подписанный вебхук. Своих узлов и кошельков у нас нет.
# Режим: off (метода нет), staff (виден только сотрудникам — так проверяют
# боевые ключи), on (открыт всем). Правится и в админке.
CRYPTO_PAYMENTS_MODE=off
NOWPAYMENTS_API_KEY=
# Генерируется в кабинете процессора (Settings -> Payments). Без него
# вебхуки не принимаются вообще.
NOWPAYMENTS_IPN_SECRET=
# 1 — песочница (account.sandbox.nowpayments.io, отдельный ключ!)
NOWPAYMENTS_SANDBOX=0
# Валюта кошелька выплат у процессора (код, напр. usdtbsc): по ней считается
# минимальная сумма счёта. Переопределяется в админке.
NOWPAYMENTS_SETTLEMENT_CURRENCY=
# Пусто — адрес API выбирается по NOWPAYMENTS_SANDBOX
NOWPAYMENTS_API_URL=
# Курс, по которому выставляется криптосчёт (пусто в админке = живой курс)
# CURRENCY_KGS_TO_USD_RATE=0.0115
# Сколько живёт счёт и какие монеты показывать
# CRYPTO_INVOICE_TTL_MINUTES=60
# CRYPTO_ALLOWED_CURRENCIES=usdttrc20,usdtton,usdterc20,usdtbsc,btc,eth,ton,ltc,trx,bnbbsc,sol,doge
# Недоплата в пределах этого процента считается полной (комиссия сети)
# CRYPTO_FULL_TOLERANCE_PERCENT=0.5
# Переплату зачисляем не выше этого процента, дальше — ручной разбор
# CRYPTO_OVERPAY_CAP_PERCENT=200
# ВАЖНО: адрес для вебхуков берётся из SITE_BASE_URL — он обязан указывать
# на боевой домен и быть https.

# --- Курсы валют (опц., для конвертации) ---
EXCHANGE_API_KEY=
EXCHANGE_API_BASE=

# --- OAuth: Google ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# --- Telegram Login ---
TELEGRAM_BOT_TOKEN=0000000000:AA...your-bot-token
TELEGRAM_BOT_ID=0000000000
TELEGRAM_BOT_USERNAME=YourBot_bot

# --- OAuth: Facebook/Instagram (опц., в проде не используются) ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# --- Гостевой режим / лимиты (опц., есть дефолты) ---
# GUEST_FREE_REQUESTS=3
# DRF_THROTTLE_ANON=30/min
# DRF_THROTTLE_USER=120/min
# Оценочная ставка расхода OpenRouter для дашборда (USD/токен)
# AUDIT_OPENROUTER_USD_PER_TOKEN=0.0000005

# --- Telegram-бот (товарный, отдельный от бота входа на сайт) ---
# Токен берётся у @BotFather. Бот входа на сайт (TELEGRAM_BOT_TOKEN выше) —
# другой: у них разные токены, но id пользователя в Telegram один на все боты,
# поэтому аккаунт и баланс у человека остаются общими с сайтом.
TELEGRAM_PRODUCT_BOT_TOKEN=
TELEGRAM_PRODUCT_BOT_USERNAME=
# Общий секрет, которым бот подписывает служебные запросы к нам.
# Сгенерировать: openssl rand -hex 32. Пусто — бот отключён, эндпоинты закрыты.
BOT_SERVICE_SECRET=
# Рубильник исходящих сообщений (бонусы, пополнения, готовые ролики).
TELEGRAM_NOTIFY_ENABLED=0
# staff — бот отвечает только своим (обкатка), all — всем.
BOT_ACCESS=staff
BOT_STAFF_IDS=
BOT_DEFAULT_MODEL=google/gemini-2.5-flash
# Режим приёма апдейтов: polling (по умолчанию) или webhook. Для вебхука nginx
# уже проксирует /tg-webhook/ на bot:8081 только с сетей Telegram.
BOT_MODE=polling
BOT_WEBHOOK_BASE=
BOT_WEBHOOK_SECRET=
BOT_WEBHOOK_PATH=/tg-webhook/
BOT_WEBHOOK_PORT=8081
# Распознавание голосовых: модель через OpenRouter и цена по минутам.
STT_MODEL=google/gemini-2.5-flash-lite
STT_CREDITS_PER_MINUTE=2
STT_MAX_SECONDS=120
# Очередь долгих генераций (видео из бота, сцены студии) — воркер celery_media.
CELERY_MEDIA_QUEUE=media
CELERY_MEDIA_CONCURRENCY=3

# --- Видеостудия (/video-studio) ---
# off — студии нет; staff — генерируют только сотрудники (обкатка);
# on — все. Незнакомое значение читается как staff.
VSTUDIO_MODE=staff
# Очередь и воркер студии (celery_vstudio). Локальный стенд с одним воркером:
# оставьте пустыми и CELERY_VSTUDIO_QUEUE, и CELERY_MEDIA_QUEUE — тогда всё
# идёт в общую очередь. Пустая только студийная — задачи уйдут в media.
CELERY_VSTUDIO_QUEUE=vstudio
CELERY_VSTUDIO_CONCURRENCY=4
# Сколько генераций одного человека идут одновременно
# VSTUDIO_MAX_OPEN_VIDEO=2
# VSTUDIO_MAX_OPEN_IMAGE=4
# Сколько часов опрашивать принятый провайдером ролик, потом — lost (не меньше 1)
# VSTUDIO_GIVE_UP_HOURS=6
# Только локальный стенд: референсы уходят провайдеру data-URL (localhost
# ему недоступен). На проде 0 — там нужен публичный https SITE_BASE_URL.
# VSTUDIO_INLINE_REFS=0
# Ниже этого баланса OpenRouter (USD) новые запуски получают 503 до резерва
# VSTUDIO_MIN_PROVIDER_USD=2
# Модель для «Сжать с ИИ» (бесплатно для человека, 20 раз в час)
# VSTUDIO_ASSIST_MODEL=google/gemini-2.5-flash
# Через сколько дней удалённые материалы стираются с диска
# VSTUDIO_PURGE_DAYS=30
# Лимиты запросов к /api/vstudio/ (у каждого вида свой счётчик)
# DRF_THROTTLE_VSTUDIO_READ=120/min
# DRF_THROTTLE_VSTUDIO_WRITE=30/min
# DRF_THROTTLE_VSTUDIO_QUOTE=90/min
# DRF_THROTTLE_VSTUDIO_RUN=20/min
# DRF_THROTTLE_VSTUDIO_POLL=60/min
# DRF_THROTTLE_VSTUDIO_UPLOAD=40/min
# DRF_THROTTLE_VSTUDIO_ASSIST=20/hour
# Фронт (при сборке next): пункт меню, sitemap и индексация /video-studio.
# Ставить 1 только вместе с VSTUDIO_MODE=on.
NEXT_PUBLIC_VSTUDIO_NAV=
# Оплата Telegram Stars: off / staff / on (переопределяется в админке).
STARS_PAYMENTS_MODE=on
