    "faq": {
        "title": "🟡 Help / Frequently Asked Questions (FAQ)",
        "questions": {
            "0": {
                "q": "How to create my first song or image?",
                "a": "Sign up, choose a category (music or image), enter a text prompt, click 'Generate' — and get the result in seconds."
            },
            "1": {
                "q": "How many generations are available in my plan?",
                "a": [
                    "Free — 1 generation per day for 7 days",
                    "Basic — 50 generations per month",
                    "Standard — 100 generations + bonuses",
                    "Pro, Premium, Enterprise — extended limits and discounts"
                ]
            },
            "2": {
                "q": "What if generation fails?",
                "a": "If you see an error or strange result, just try again — generations are only deducted on success. If the problem persists, contact support."
            },
            "3": {
                "q": "How to activate the trial?",
                "a": "Just sign up — the trial activates automatically, no card required."
            },
            "4": {
                "q": "How to pay for a subscription?",
                "a": [
                    "Freedom Pay (Kyrgyzstan)",
                    "YuMoney (Russia & CIS)",
                    "Bank cards and e-wallets",
                    "All payments are secure"
                ]
            },
            "5": {
                "q": "How does the referral program work?",
                "a": "Invite friends using your referral link and get bonus generations. +5 free generations for each active user."
            },
            "6": {
                "q": "How to change or cancel my plan?",
                "a": "Go to your account, select a plan and click 'Switch'. You can cancel anytime — access stays until the end of the paid period."
            },
            "7": {
                "q": "How to contact support?",
                "a": "Write to support@vokalo.online or Telegram: @VokaloSupportBot"
            }
        }
    },
