#!/usr/bin/env bash
set -euo pipefail

# Start full local development stack:
# - Django: manage.py runserver
# - Next.js: npm run dev
# - Postgres/Redis
# - Celery worker/beat
# - Nginx reverse proxy on :80
#
# Usage:
#   ./scripts/up-dev
#   ./scripts/up-dev --build

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/.."

FILES=(-f compose.dev.yaml)

if [[ "${1:-}" == "--build" ]]; then
  docker compose "${FILES[@]}" build
fi

docker compose "${FILES[@]}" up -d db redis

echo "Generating and applying migrations (dev auto-bootstrap) ..."
docker compose "${FILES[@]}" run --rm core python manage.py makemigrations --noinput
docker compose "${FILES[@]}" run --rm core python manage.py migrate --noinput

docker compose "${FILES[@]}" up -d --remove-orphans core next celery celery_beat nginx

echo "Waiting for app readiness on http://localhost ..."
for i in $(seq 1 120); do
  if curl -fsS http://localhost/ >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

if ! curl -fsS http://localhost/ >/dev/null 2>&1; then
  echo "App is still not ready after timeout. Check logs:"
  echo "  docker compose -f compose.dev.yaml logs -f next core nginx"
  exit 1
fi

echo "Ensuring dev superuser exists ..."
# Local dev admin account. Override with env, e.g.:
#   DEV_SUPERUSER_EMAIL=me@example.com DEV_SUPERUSER_PASSWORD=change-me ./scripts/up-dev
# Without DEV_SUPERUSER_PASSWORD a random password is generated for a new
# account, and an existing account keeps its current password.
DEV_SUPERUSER_EMAIL="${DEV_SUPERUSER_EMAIL:-admin@example.com}"
DEV_SUPERUSER_SET_PASSWORD=1
if [[ -z "${DEV_SUPERUSER_PASSWORD:-}" ]]; then
  DEV_SUPERUSER_PASSWORD="$(openssl rand -hex 12 2>/dev/null || od -An -N12 -tx1 /dev/urandom | tr -d ' \n')"
  DEV_SUPERUSER_SET_PASSWORD=0
fi
if SUPERUSER_STATUS="$(docker compose "${FILES[@]}" exec -T \
  -e DEV_SUPERUSER_EMAIL="$DEV_SUPERUSER_EMAIL" \
  -e DEV_SUPERUSER_PASSWORD="$DEV_SUPERUSER_PASSWORD" \
  -e DEV_SUPERUSER_SET_PASSWORD="$DEV_SUPERUSER_SET_PASSWORD" \
  core python manage.py shell -c "
import os
from django.contrib.auth import get_user_model
User = get_user_model()
email = os.environ['DEV_SUPERUSER_EMAIL']
password = os.environ['DEV_SUPERUSER_PASSWORD']
u = User.objects.filter(email=email).first()
if u is None:
    try:
        User.objects.create_superuser(email=email, password=password)
    except TypeError:
        u = User(email=email, is_staff=True, is_superuser=True, is_active=True)
        u.set_password(password)
        u.save()
    print('created')
else:
    u.is_staff = True
    u.is_superuser = True
    u.is_active = True
    fields = ['is_staff', 'is_superuser', 'is_active']
    if os.environ.get('DEV_SUPERUSER_SET_PASSWORD') == '1':
        u.set_password(password)
        fields.append('password')
    u.save(update_fields=fields)
    print('updated')
")"; then
  echo "$SUPERUSER_STATUS"
  if [[ "$DEV_SUPERUSER_SET_PASSWORD" == "0" && "$SUPERUSER_STATUS" == *created* ]]; then
    echo "Dev superuser: $DEV_SUPERUSER_EMAIL, generated password: $DEV_SUPERUSER_PASSWORD (local stack only)"
  else
    echo "Dev superuser: $DEV_SUPERUSER_EMAIL"
  fi
else
  echo "Warning: failed to ensure dev superuser ($DEV_SUPERUSER_EMAIL)."
fi

cat <<'EOF'
Dev stack is up.
- App via nginx: http://localhost
- Next dev direct: http://localhost:3000
- Django direct:   http://localhost:8000

Useful:
- logs: docker compose -f compose.dev.yaml logs -f
- stop: docker compose -f compose.dev.yaml down
EOF
